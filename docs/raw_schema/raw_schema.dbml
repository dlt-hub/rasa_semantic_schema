// =============================================================================
// Rasa Semantic Schema — RAW (SOURCE) SCHEMA
// =============================================================================
// Best-effort reverse engineering of the source schemas that the Rasa Ingestion
// Pipeline produces and that this dbt package reads from (see models/sources.yml
// and README_SOURCE_SCHEMA.md).
//
// There are two physical source schemas, both sharing a {schema_prefix}:
//   * {schema_prefix}_event  — raw tracker store events (this file, "event" group)
//   * {schema_prefix}_model  — bot models: stories, rules, domains ("model" group)
//
// IMPORTANT — this schema is autogenerated:
//   The raw schema is produced by recursively unpacking the tracker-store JSON
//   documents. Simple values / objects are flattened into columns named
//   `<field>__<nested_field>__..__<leaf>`; lists become child tables linked to
//   the parent by hash. Columns therefore appear/disappear as the bot data
//   changes. The columns below are the ones actually consumed by the dbt models
//   plus the common/propagated columns documented in README_SOURCE_SCHEMA.md.
//   Real tables will have more (auto-discovered) columns than listed here.
//
// Inferred types: the unpacking engine infers string / double / bigint /
// timestamp; conflicting types yield variant columns.
// =============================================================================

Project rasa_raw_schema {
  database_type: 'Redshift / BigQuery'
  Note: '''
    Source (raw) schema for the Rasa Semantic Schema dbt package.
    Reverse-engineered from models/sources.yml, the staging/view SQL that reads
    these sources, and README_SOURCE_SCHEMA.md. The event_<type> tables are
    level-0 break-downs of `event` by event_type; each shares its `_record_hash`
    with the matching row in `event` (1:1). Child tables of the form
    event_<type>__<nested> (not enumerated) link back via `_parent_hash`.
  '''
}

// -----------------------------------------------------------------------------
// {schema_prefix}_event  — tracker store events
// -----------------------------------------------------------------------------

// Level-0 table: the ordered stream of all events for every conversation.
// event_<type> tables below are typed projections of this table.
Table event {
  _record_hash   varchar      [pk, note: 'Unique id of the record']
  _root_hash     varchar      [note: 'Unique id of top-level parent (== _record_hash at top level)']
  event          varchar      [note: 'Event type discriminator: user / bot / slot / action / active_loop / session_started ...']
  "timestamp"    timestamp    [note: 'Event timestamp']
  model_id       varchar      [note: 'Id of the model that generated the event (SDK 3.0+ or inferred from Rasa X)']
  sender_id      varchar      [note: 'Conversation id (Rasa sender id)']
  environment    varchar      [note: 'Deployment environment (e.g. production / development / test)']
  _load_id       varchar      [note: 'Batch identifier, used in incremental loading; FK to _loads.load_id']

  Note: 'Corresponds to the tracker; represents the order of events for a conversation. README common columns + auto-unpacked fields.'
}

Table event_user {
  _record_hash               varchar     [pk]
  _root_hash                 varchar
  event                      varchar      [note: "Constant 'user' in this table"]
  "timestamp"                timestamp
  model_id                   varchar
  sender_id                  varchar
  environment                varchar
  _load_id                   varchar
  message_id                 varchar      [note: 'Rasa message id of the user utterance']
  text                       varchar      [note: 'User message text']
  input_channel              varchar      [note: 'Channel the message arrived on']
  parse_data__intent__name   varchar      [note: 'Predicted intent name (flattened from parse_data.intent.name)']
  parse_data__intent__confidence  double  [note: 'Intent confidence (flattened)']
  metadata__user_id          varchar      [note: 'OPTIONAL custom external user id passed in message metadata (configurable via var user_id)']
  metadata__external_session_id  varchar  [note: 'OPTIONAL custom external session id passed in metadata (configurable via var external_session_id)']

  Note: 'User message events. Many parse_data__* and metadata__* columns exist depending on the bot; only the consumed ones are shown.'
}

Table event_bot {
  _record_hash            varchar    [pk]
  _root_hash              varchar
  event                   varchar     [note: "Constant 'bot'"]
  "timestamp"             timestamp
  model_id                varchar
  sender_id               varchar
  environment             varchar
  _load_id                varchar
  text                    varchar     [note: 'Bot message text']
  metadata__utter_action  varchar     [note: 'Utter/action template name that produced the bot message']

  Note: 'Bot utterance / action events.'
}

Table event_slot {
  _record_hash   varchar    [pk]
  _root_hash     varchar
  event          varchar     [note: "Constant 'slot'"]
  "timestamp"    timestamp
  model_id       varchar
  sender_id      varchar
  environment    varchar
  _load_id       varchar
  name           varchar     [note: "Slot name. Special value 'requested_slot' marks a slot request"]
  value          varchar     [note: 'Slot value set (null/absent when only requested)']

  Note: 'Slot set / requested events.'
}

Table event_action {
  _record_hash   varchar    [pk]
  _root_hash     varchar
  event          varchar     [note: "Constant 'action'"]
  "timestamp"    timestamp
  model_id       varchar
  sender_id      varchar
  environment    varchar
  _load_id       varchar
  name           varchar     [note: "Action name (e.g. action_listen, action_session_start, action_restart, action_default_fallback ...)"]
  confidence     double      [note: 'Policy confidence for the predicted action']

  Note: 'Executed action events. Drives session boundaries (action_session_start / action_restart) and metrics.'
}

Table event_active_loop {
  _record_hash   varchar    [pk]
  _root_hash     varchar
  event          varchar     [note: "Constant 'active_loop'"]
  "timestamp"    timestamp
  model_id       varchar
  sender_id      varchar
  environment    varchar
  _load_id       varchar
  name           varchar     [note: 'Active form/loop name; null when the loop is deactivated']

  Note: 'Active loop (form) activation/deactivation events. OPTIONAL: table only exists for bots that use forms (see macros/has_active_loop.sql).'
}

Table event_session_started {
  _record_hash      varchar  [pk]
  _root_hash        varchar
  event             varchar   [note: "Constant 'session_started'"]
  "timestamp"       timestamp
  model_id          varchar
  sender_id         varchar
  environment       varchar
  _load_id          varchar
  metadata__user_id varchar   [note: 'OPTIONAL external user id (SDK <= 2.8 stopped sending session metadata)']

  Note: 'Session start markers. Mostly metadata-only; value column is null in the unioned staging.'
}

// System table: history of loaded batches; powers incremental processing.
Table _loads {
  load_id      varchar     [note: 'Batch / load identifier']
  status       integer     [note: '0 = pending, 1 = processed (set by this package once a load is consumed)']
  inserted_at  timestamp   [note: 'When the status row was written']

  Note: 'New data = load_ids in _loads that have exactly one row with status 0. The package inserts status=1 rows after successful processing. Never full-refreshed.'
}

// System table: schema migration history (named _version in sources.yml, _versions in README).
Table _version {
  version  varchar  [note: 'Schema version / migration identifier']

  Note: 'Holds history of schema migrations generated by the unpacking engine. Existence of `version` is asserted by a prerequisites test.'
}

// -----------------------------------------------------------------------------
// {schema_prefix}_model  — bot model: stories, rules, domain
// -----------------------------------------------------------------------------

Table model {
  model_id     varchar     [pk, note: 'Model id referenced by events.model_id']
  name         varchar     [note: 'Model name (asserted to exist by prerequisites test)']
  sdk_version  varchar     [note: 'Rasa SDK version; combined with name to build model_name_custom in the views schema']
  "timestamp"  timestamp   [note: 'Model timestamp']
  _load_id     varchar
  _record_hash varchar

  Note: 'One row per bot model. Only `model` is consumed by the dbt package (models/views/models.sql).'
}

// The model schema also contains stories / rules / domain tables (and their
// child tables) produced by unpacking the bot model, with the same
// parent/child hash-linking rules. They are documented in README_SOURCE_SCHEMA.md
// but are NOT consumed by the dbt package, so their columns are left as
// placeholders here.
Table stories {
  _record_hash varchar [pk]
  model_id     varchar
  Note: 'Bot stories (placeholder — auto-unpacked, not used by the package).'
}

Table rules {
  _record_hash varchar [pk]
  model_id     varchar
  Note: 'Bot rules (placeholder — auto-unpacked, not used by the package).'
}

Table domain {
  _record_hash varchar [pk]
  model_id     varchar
  Note: 'Bot domain (placeholder — auto-unpacked, not used by the package).'
}

// -----------------------------------------------------------------------------
// References
// -----------------------------------------------------------------------------

// Each typed event table is a 1:1 projection of `event`, sharing _record_hash.
Ref: event_user._record_hash            - event._record_hash
Ref: event_bot._record_hash             - event._record_hash
Ref: event_slot._record_hash            - event._record_hash
Ref: event_action._record_hash          - event._record_hash
Ref: event_active_loop._record_hash     - event._record_hash
Ref: event_session_started._record_hash - event._record_hash

// Events belong to a load batch.
Ref: event._load_id > _loads.load_id

// Events were produced by a model.
Ref: event.model_id > model.model_id

// Model components belong to a model.
Ref: stories.model_id > model.model_id
Ref: rules.model_id   > model.model_id
Ref: domain.model_id  > model.model_id

// TableGroups for readability in dbdiagram.io
// {schema_prefix}_event
TableGroup event_schema {
  event
  event_user
  event_bot
  event_slot
  event_action
  event_active_loop
  event_session_started
  _loads
  _version
}

// {schema_prefix}_model
TableGroup model_schema {
  model
  stories
  rules
  domain
}
